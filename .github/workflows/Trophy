name: Generate Trophies

on:
  schedule:
    - cron: "0 0 * * 0"    # once a week (trophies don't change fast)
  workflow_dispatch: {}
  push:
    branches:
      - main

jobs:
  generate:
    permissions:
      contents: write
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Fetch trophy SVG
        run: |
          set -e
          HTTP_CODE=$(curl -sSL -w "%{http_code}" \
            "https://github-profile-trophy.vercel.app/?username=Sujalkan07&no-frame=true&row=1&column=6" \
            -o assets/trophies.svg)
          echo "HTTP status: $HTTP_CODE"
          echo "Response size: $(wc -c < assets/trophies.svg) bytes"
          echo "First 200 chars:"
          head -c 200 assets/trophies.svg
          echo ""
          if [ "$HTTP_CODE" -ne 200 ]; then
            echo "::error::Trophy service returned HTTP $HTTP_CODE"
            exit 1
          fi
          if ! grep -q "<svg" assets/trophies.svg; then
            echo "::error::Response does not contain a valid <svg> tag - likely rate limited or errored"
            exit 1
          fi
          FILESIZE=$(wc -c < assets/trophies.svg)
          if [ "$FILESIZE" -lt 500 ]; then
            echo "::error::Response is suspiciously small ($FILESIZE bytes) - likely an error/empty SVG"
            exit 1
          fi

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add assets/trophies.svg
          git diff --staged --quiet || git commit -m "chore: update trophies"
          git push
